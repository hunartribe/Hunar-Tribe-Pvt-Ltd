# Vite content-hashes asset filenames, so they are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must never be cached, or staff keep running the previous deploy.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The admin is a private tool; keep it out of search results entirely.
/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
