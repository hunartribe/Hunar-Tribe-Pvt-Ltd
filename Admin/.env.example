# Firebase project the admin writes to. Vite inlines VITE_* at BUILD time,
# so rebuild (or pass these as docker compose build args) after changing them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firestore database id. This project uses a named database, not "(default)".
VITE_FIREBASE_DATABASE_ID=hunar-tribe

# Public site URL, used for the "View on site" links in the admin.
VITE_SITE_URL=http://localhost:3000
