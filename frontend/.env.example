# Firebase project the public site reads content from. Vite inlines VITE_* at
# BUILD time, so rebuild after changing them. When unset, the values baked into
# src/Firebase/FireBaseConfig.js (the existing hunar-tribe project) are used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firestore database id. This project uses a named database, not "(default)".
VITE_FIREBASE_DATABASE_ID=hunar-tribe
VITE_FIREBASE_MEASUREMENT_ID=
